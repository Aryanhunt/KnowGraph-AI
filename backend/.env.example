# =============================================================================
# KnowGraph AI — backend configuration
# Copy this file to `backend/.env` and adjust values for your machine.
# Every AI component is configurable here; nothing is hard-coded in the code.
# =============================================================================

# --- Application -------------------------------------------------------------
# Backend port. 5000 is reserved by macOS AirPlay Receiver, so the default is 5003.
PORT=5003

APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB (metadata only — binaries stay on disk) -------------------------
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=knowgraph

# --- File storage ------------------------------------------------------------
# Relative paths are resolved against the backend/ directory.
STORAGE_DIR=storage
MAX_UPLOAD_MB=50

# --- Local LLM (Ollama) ------------------------------------------------------
# No online AI provider is supported by design.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_MAX_TOKENS=1024

# --- Embeddings --------------------------------------------------------------
# Provider: ollama | hashing
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_SECONDS=60
# Dimension used by the deterministic `hashing` fallback embedder.
HASHING_EMBEDDING_DIM=512

# --- OCR ---------------------------------------------------------------------
# Engine: tesseract | paddleocr | none (engines are pluggable via OCRService)
OCR_ENGINE=tesseract
TESSERACT_CMD=
OCR_LANG=eng
# A PDF page with less than this many usable characters is treated as scanned.
OCR_MIN_CHARS_PER_PAGE=80
PDF_RENDER_ZOOM=2.0
OCR_ENABLED=true

# --- OCR preprocessing (Phase 2) ----------------------------------------------
# Master switch for image preprocessing before OCR (default: true).
OCR_PREPROCESS=true
# Comma-separated list of steps to enable. Empty = sensible defaults
# (grayscale, thresholding, deskew). Available steps:
#   grayscale, upscale, denoise, contrast, thresholding, deskew, strip_borders
# Example: OCR_PREPROCESS_STEPS=grayscale,thresholding
OCR_PREPROCESS_STEPS=
# Upscale factor applied before OCR (1.0 = no upscaling).
OCR_UPSCALE_FACTOR=1.0
# Contrast enhancement factor used when the contrast step is enabled.
OCR_CONTRAST_FACTOR=1.5
# Safety cap for processed image dimensions (avoids memory explosions).
OCR_PREPROCESS_MAX_DIM=4000

# --- OCR quality thresholds (Phase 3) ------------------------------------------
# Confidence >= this → "good". Confidence >= acceptable → "acceptable".
OCR_QUALITY_GOOD_CONFIDENCE=80.0
OCR_QUALITY_ACCEPTABLE_CONFIDENCE=60.0
# Pages recognising fewer words than this are flagged as poor.
OCR_QUALITY_MIN_WORDS=5

# --- Vector database ---------------------------------------------------------
# Backend: chroma | numpy
VECTOR_DB=chroma
CHROMA_COLLECTION=knowgraph_chunks

# --- Chunking / retrieval ----------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=6
RAG_MAX_CONTEXT_CHARS=8000
RAG_HISTORY_TURNS=4
HYBRID_SEARCH=true

# --- Background processing ---------------------------------------------------
PROCESSING_WORKERS=2
PROCESSING_SYNC=false

# --- Knowledge graph ---------------------------------------------------------
GRAPH_MIN_CONCEPT_SCORE=0.08
GRAPH_MAX_CONCEPTS_PER_DOC=100
GRAPH_MAX_RELATIONS_PER_CONCEPT=8
# Local LLM may discover relations the deterministic pass missed (fully offline).
GRAPH_ENABLE_LLM_RELATIONS=true
# Per-document cap on LLM section calls (keeps CPU-only runs fast).
GRAPH_MAX_LLM_SECTIONS=3
# Minimum model-reported confidence accepted for a new LLM relation.
GRAPH_LLM_MIN_CONFIDENCE=0.55
# Optional web cross-check; disabled by default and never required to store a relation.
GRAPH_ENABLE_WEB_CHECK=false
GRAPH_WEB_CHECK_TIMEOUT_SECONDS=6

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_TO_FILE=true